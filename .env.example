# 复制为 .env 后填写。真实 key 在 /home/peng/.dsh/.env 的 MINIMAX_CN_API_KEY
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com
MODEL_BRAIN=MiniMax-M3.1-Flash-Preview
MODEL_FAST=MiniMax-M2.5-highspeed
MODEL_BACKUP=MiniMax-M2.1
LLM_TEMPERATURE=0
LLM_TIMEOUT=60
MOCK_MODE=false
# 能力令牌签名密钥：64 位十六进制（python3.12 -c "import secrets;print(secrets.token_hex(32))"）
# 缺失或格式不对时黄灯/红灯链路一律 fail closed，不会退回默认密钥
CAPABILITY_SECRET=
