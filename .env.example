# ==========================================================================
# 模型配置模板 —— 复制为 .env 后填写自己的密钥
#
#   一键配置：bash scripts/setup.sh（或 make setup）会按需生成这个文件并挑好模型来源
#   cp .env.example .env    然后按下面 ① ② ③ 三行填自己的值
#
# 仓库公开、不含任何密钥；模型完全由这个文件（或同名环境变量）决定。
# 默认厂商是 MiniMax，但代码只依赖 OpenAI 兼容协议，换厂商只改这三行。
# 完整说明（各厂商示例、兼容性要求、报错速查）见 docs/模型配置说明.md
# ==========================================================================

# ① API key（必填，除非用 MOCK_MODE=script 走零网络离线桩）
#    旧名 MINIMAX_API_KEY 仍然生效；两者同时存在时以本行为准。
LLM_API_KEY=

# ② Base URL：OpenAI 兼容网关地址
#    末尾带 /v1、/v4 时只补 /chat/completions，否则自动补 /v1/chat/completions
#    例：https://api.minimaxi.com | https://api.deepseek.com | https://api.openai.com/v1
#        http://localhost:11434/v1 （Ollama 本地）
#    旧名 MINIMAX_API_HOST 仍然生效。
LLM_BASE_URL=https://api.minimaxi.com

# ③ 主脑模型名（要跟 ② 家的模型列表一致）
#    旧名 MODEL_BRAIN 仍然生效。
LLM_MODEL=MiniMax-M3.1-Flash-Preview

# ④ 可选：直接指定完整 endpoint。base 拼接规则不适用时用它（例如智谱 v4）
LLM_ENDPOINT=

# ⑤ 快模型 / 备脑
#    LLM_MODEL_FAST：L2 注入分类用的快模型（生产主链路未启用）
#    LLM_MODEL_BACKUP：仅供 python3.12 -m app.smoke 做思维链剥离自检
#    旧名 MODEL_FAST / MODEL_BACKUP 仍然生效。
LLM_MODEL_FAST=MiniMax-M2.5-highspeed
LLM_MODEL_BACKUP=MiniMax-M2.5

# ⑥ 降级链（可选）：主目标 401/超时/5xx/429 时按顺序换下一个目标
#    只切「换一个还有救」的错误；HTTP 400/422（请求体不合法）直接报错，不降级。
#
#    ① 同厂商降级：同一个 base url、同一把 key，只换模型名（逗号分隔，先上这个最省事）
LLM_FALLBACK=
#    例：LLM_FALLBACK=MiniMax-M2.5-highspeed,MiniMax-M2.5
#
#    ② 跨厂商降级：base_url::模型名::KEY_ENV_NAME
#    第三段是**环境变量名**，不是密钥本身——配置串里永远不出现密钥。
LLM_FALLBACK_VENDORS=
#    例：LLM_FALLBACK_VENDORS=https://api.deepseek.com::deepseek-chat::DEEPSEEK_API_KEY
#    该环境变量没设时，这个目标报 no_key 并跳过，不会拿空 key 去请求。
#    降级目标同样要满足：tools / tool_choice:"auto" / SSE 收尾；
#    换之前先跑 python3.12 -m scripts.provider_check 验一遍。

# ⑦ 调用参数
LLM_TEMPERATURE=0
LLM_TIMEOUT=60

# ⑧ 运行模式
#    false    正常走真实模型（默认）
#    true     对抗演示专用：把模型换成恶意的固定桩，用来演示「模型被劫持也动不了一分钱」
#    script   协作回放桩：纯规则、确定性、零网络，断网也能演查余额与转账
MOCK_MODE=false

# ⑨ 能力令牌签名密钥：64 位十六进制
#    留空（不设置）= 首次运行自动生成到 data/token_secret（权限 0600，已 gitignore），重启复用；
#      删掉该文件即轮换（已签出的令牌随之失效，TTL 只有 120 秒）
#    想显式指定就填一把：python3.12 -c "import secrets;print(secrets.token_hex(32))"
#    注意：这里一旦填了（哪怕填成空字符串）就只认 64 位十六进制，格式不对立刻 fail closed，
#      不会退回自动生成、更不会用默认密钥
CAPABILITY_SECRET=
# 自动生成密钥的落盘路径（可选，默认 data/token_secret）
# CAPABILITY_SECRET_FILE=data/token_secret

# ⑩ 确认卡等待窗口（秒）：10—3600，默认 120
#    影响 SSE 的 expires_in_s、确认卡 expires_ms 与执行器等待时长三处；非法值回落 120 并打警告
# CONFIRM_TIMEOUT_S=120
