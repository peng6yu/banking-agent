# ==========================================================================
# 模型配置模板 —— 复制为 .env 后填写自己的密钥
#
#   cp .env.example .env    然后按下面 ① ② ③ 三行填自己的值
#
# 仓库公开、不含任何密钥；模型完全由这个文件（或同名环境变量）决定。
# 默认厂商是 MiniMax，但代码只依赖 OpenAI 兼容协议，换厂商只改这三行。
# 完整说明（各厂商示例、兼容性要求、报错速查）见 docs/模型配置说明.md
# ==========================================================================

# ① API key（必填，除非用 MOCK_MODE=script 走零网络离线桩）
#    旧名 MINIMAX_API_KEY 仍然生效；两者同时存在时以本行为准。
LLM_API_KEY=

# ② Base URL：OpenAI 兼容网关地址
#    末尾带 /v1、/v4 时只补 /chat/completions，否则自动补 /v1/chat/completions
#    例：https://api.minimaxi.com | https://api.deepseek.com | https://api.openai.com/v1
#        http://localhost:11434/v1 （Ollama 本地）
#    旧名 MINIMAX_API_HOST 仍然生效。
LLM_BASE_URL=https://api.minimaxi.com

# ③ 主脑模型名（要跟 ② 家的模型列表一致）
#    旧名 MODEL_BRAIN 仍然生效。
LLM_MODEL=MiniMax-M3.1-Flash-Preview

# ④ 可选：直接指定完整 endpoint。base 拼接规则不适用时用它（例如智谱 v4）
LLM_ENDPOINT=

# ⑤ 快模型 / 备脑
#    LLM_MODEL_FAST：L2 注入分类用的快模型（生产主链路未启用）
#    LLM_MODEL_BACKUP：仅供 python3.12 -m app.smoke 做思维链剥离自检
#    旧名 MODEL_FAST / MODEL_BACKUP 仍然生效。
LLM_MODEL_FAST=MiniMax-M2.5-highspeed
LLM_MODEL_BACKUP=MiniMax-M2.5

# ⑥ 调用参数
LLM_TEMPERATURE=0
LLM_TIMEOUT=60

# ⑦ 运行模式
#    false    正常走真实模型（默认）
#    true     对抗演示专用：把模型换成恶意的固定桩，用来演示「模型被劫持也动不了一分钱」
#    script   协作回放桩：纯规则、确定性、零网络，断网也能演查余额与转账
MOCK_MODE=false

# ⑧ 能力令牌签名密钥：64 位十六进制
#    生成：python3.12 -c "import secrets;print(secrets.token_hex(32))"
#    缺失或格式不对时黄灯/红灯链路一律 fail closed，不会退回默认密钥
CAPABILITY_SECRET=
